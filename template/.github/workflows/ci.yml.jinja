name: CI

on:
  push:
    branches:
      - main
  pull_request:
  # The Prepare release workflow starts CI on its release branch this way: a
  # pull request opened with the default Actions token triggers no workflows,
  # so its required checks would otherwise never report.
  workflow_dispatch:

permissions:
  contents: read

jobs:
  ci:
    # Moving major tag on purpose (see .github/zizmor.yml): we own this repo,
    # so CI fixes flow in without a bump PR per template release. Dependabot
    # is told to leave it alone in .github/dependabot.yml — don't "helpfully"
    # pin this to an exact version, or copier update will just revert it.
    uses: {{ github_owner }}/python-project-template/.github/workflows/python-ci.yml@v1
    with:
      python-version: "{{ python_version }}"
{% if use_frontend %}

  # Biome (lint + format) runs in the pre-commit stack above, so this job only
  # covers what needs the frontend's own dependencies installed.
  frontend:
    uses: {{ github_owner }}/python-project-template/.github/workflows/node-ci.yml@v1
    with:
      working-directory: "{{ frontend_dir }}"
{% endif %}
