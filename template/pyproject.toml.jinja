{% if project_kind == "library" -%}
[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

{% endif -%}
[project]
name = "{{ project_name }}"
{% if project_kind == "library" -%}
dynamic = ["version"]
{% else -%}
version = "0.1.0"
{% endif -%}
description = "{{ project_description }}"
readme = "README.md"
license = "{{ 'LicenseRef-Proprietary' if license == 'Proprietary' else license }}"
authors = [{ name = "{{ author_name }}", email = "{{ author_email }}" }]
requires-python = ">={{ python_version }}"
dependencies = []
{% if project_kind == "library" %}
[project.urls]
Homepage = "https://github.com/{{ github_owner }}/{{ project_name }}"
Repository = "https://github.com/{{ github_owner }}/{{ project_name }}"
Issues = "https://github.com/{{ github_owner }}/{{ project_name }}/issues"
{% endif %}
[dependency-groups]
dev = [
    "pytest>=8.0.0",
    "pytest-cov>=7.0.0",
    "basedpyright>=1.39",
    "pre-commit>=4.0.0",
    "scriv>=1.8",
]

{% if project_kind == "library" -%}
[tool.hatch.version]
path = "src/{{ package_name }}/__init__.py"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ package_name }}"]
{% else -%}
[tool.uv]
package = false
{% endif %}
[tool.scriv]
# One fragment per pull request in changelog.d/, collected into CHANGELOG.md
# at release time, so concurrent PRs never edit the same lines of the changelog.
format = "md"
fragment_directory = "changelog.d"
categories = ["Added", "Changed", "Deprecated", "Removed", "Fixed", "Security"]
skip_fragments = "[A-Z]*" # TEMPLATE.md
new_fragment_template = "file: TEMPLATE.md"
{% raw %}
entry_title_template = "[{{ version }}] - {{ date.strftime('%Y-%m-%d') }}"
{% endraw %}
md_header_level = "2"
md_html_anchors = false
{% if project_kind == "library" %}
version = "literal: src/{{ package_name }}/__init__.py: __version__"
{% else %}
version = "literal: pyproject.toml: project.version"
{% endif %}

[tool.ruff]
line-length = 100
src = ["src"]
target-version = "py{{ python_version | replace('.', '') }}"

[tool.ruff.lint]
select = [
    "E",     # pycodestyle errors
    "W",     # pycodestyle warnings
    "F",     # pyflakes
    "I",     # isort
    "UP",    # pyupgrade
    "B",     # flake8-bugbear
    "SIM",   # flake8-simplify
    "D",     # pydocstyle
    "C4",    # flake8-comprehensions
    "PT",    # flake8-pytest-style
    "PIE",   # flake8-pie
    "DTZ",   # flake8-datetimez (timezone-aware datetimes)
    "ISC",   # implicit-str-concat (catches missing commas)
    "ASYNC", # flake8-async
    "N",     # pep8-naming
    "FURB",  # refurb (modernization)
    "RUF",   # ruff-specific rules
    "PLE",   # pylint errors
    "PLW",   # pylint warnings
]
ignore = [
    "E501",   # line-too-long — the formatter owns line length
    "D10",    # missing docstrings — don't force them
    "D415",   # first-line punctuation — the module docstring is the project
    # description, whose punctuation varies
    "ISC001", # single-line implicit concat — conflicts with the formatter
]

[tool.ruff.lint.pydocstyle]
convention = "google"

[tool.ruff.lint.per-file-ignores]
"tests/**" = ["D"] # tests don't need docstring linting

[tool.basedpyright]
pythonVersion = "{{ python_version }}"
# "strict" (pyright's), not basedpyright's stricter default "recommended" —
# the based-only rules (reportAny etc.) are opt-in per project.
typeCheckingMode = "strict"
reportMissingTypeStubs = false # third-party libs are often untyped

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "-rA --durations=10 --color=yes --cov=src --cov-report=term-missing{% if use_coverage_gate %} --cov-fail-under={{ coverage_floor }}{% endif %}"
{% if project_kind == "app" -%}
pythonpath = ["."]
{% endif -%}
